@model IEnumerable<MovieLand.Models.ContactMessage>
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Messages"];
    var lan = CultureInfo.CurrentUICulture.Name == "fa-IR" ? "en-US" : "fa-IR";
}

@section Language {
    <a class="language text-nowrap" href="/Home/SetLanguage?culture=@lan&returnUrl=@Context.Request.Path">@lan</a>
}

<div class="messages-container" dir="@Localizer["dir"]">
    <h1>@Localizer["UserMessages"]</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">@Localizer["NoMessages"]</div>
    }
    else
    {
        foreach (var i in Model)
        {
            <div class="message">
                <div class="top">
                    <span class="name">@i.Name</span>
                    <span class="email">@i.Email</span>
                </div>
                <div class="bottom">
                    <p class="text">@i.Text</p>
                </div>
            </div>
        }
    }
</div>
