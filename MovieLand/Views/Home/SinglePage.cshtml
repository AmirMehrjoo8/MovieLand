@using System.Security.Claims
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    int id = ViewBag.Id;
    string format = ViewBag.Format;
    TempData["postId"] = id;
    TempData["postFormat"] = format;

}
@section Language {
    <a class="language text-nowrap" href="/Home/SetLanguage?culture=@Localizer["Language"]&id=@id&format=@format">@Localizer["Language"]</a>

    <a href="/Home/SetLanguage?culture=@Localizer["Language"]&id=@id&format=@format" class="language-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-globe" viewBox="0 0 16 16">
            <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855A8 8 0 0 0 5.145 4H7.5zM4.09 4a9.3 9.3 0 0 1 .64-1.539 7 7 0 0 1 .597-.933A7.03 7.03 0 0 0 2.255 4zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a7 7 0 0 0-.656 2.5zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5zM8.5 5v2.5h2.99a12.5 12.5 0 0 0-.337-2.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5zM5.145 12q.208.58.468 1.068c.552 1.035 1.218 1.65 1.887 1.855V12zm.182 2.472a7 7 0 0 1-.597-.933A9.3 9.3 0 0 1 4.09 12H2.255a7 7 0 0 0 3.072 2.472M3.82 11a13.7 13.7 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5zm6.853 3.472A7 7 0 0 0 13.745 12H11.91a9.3 9.3 0 0 1-.64 1.539 7 7 0 0 1-.597.933M8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855q.26-.487.468-1.068zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.7 13.7 0 0 1-.312 2.5m2.802-3.5a7 7 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7 7 0 0 0-3.072-2.472c.218.284.418.598.597.933M10.855 4a8 8 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4z" />
        </svg>
    </a>
}
<style>
    .singlePage-header .left-section {
        width: 70%;
        border-@(Localizer["SectionBorder"]): 1px solid var(--red);
    }

    .comment {
        border-@(Localizer["CommentBorder"]): 2px solid #9B0000;
        padding-@(Localizer["CommentBorder"]): 5px;
    }

    .reply {
        border-@(Localizer["CommentBorder"]): 2px solid #46009b;
        padding-@(Localizer["CommentBorder"]): 5px;
    }

    .replys {
        padding-@(Localizer["CommentBorder"]): 30px;
    }

    .top-reply {
        padding-@(Localizer["CommentBorder"]): 10px;
    }

        .top-reply img {
            margin-@(Localizer["CommentBorder"]): 5px;
        }
</style>
<div class="header-container">
    <div class="singlePage-header">
        <div class="right-section"></div>
        <div class="left-section"></div>
    </div>
    <div class="download-section">
        <h2 dir="@Localizer["dir"]">@Localizer["Download"]:</h2>
        <div class="movie-download"></div>
    </div>
    <div class="slider-section">
        <h2>@Localizer["RelatedItems"]:</h2>
        <div class="swiper related-movies-swiper">
            <div class="swiper-wrapper related-movies-wrapper"></div>

            <div class="swiper-button-prev related-movies-prev"></div>
            <div class="swiper-button-next related-movies-next"></div>
        </div>
    </div>
</div>
<div class="comment-section">
    @await Component.InvokeAsync(name: "Comment")
</div>


@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const showButton = document.getElementById("showCommentModal");
            const modalElement = document.getElementById("comment-modal");

            showButton.addEventListener("click", function () {

                if (@User.Identity.IsAuthenticated.ToString().ToLower()) {
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
                else {
                    if (window.confirm("@Localizer["CommentLoginError"]") == true) {
                        const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                        loginModal.show();
                    }
                }
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            const replyButtons = document.querySelectorAll(".showReplyModal");

            replyButtons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const modalId = btn.getAttribute("data-modal-id");
                    const modalElement = document.getElementById(modalId);
                    if (modalElement) {
                        if (@User.Identity.IsAuthenticated.ToString().ToLower()) {
                            const modal = new bootstrap.Modal(modalElement);
                            modal.show();
                        }
                        else {
                            if (window.confirm("@Localizer["CommentLoginError"]") == true) {
                                const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                                loginModal.show();
                            }
                        }
                    }
                });
            });
        });
    </script>
    <script>
        "use strict";

        const apiKey = "3778bd430a6b5a35d815d210850d537a";
        const format = "@format";
        const ID = @id;
        const language = '@Localizer["CurrentLanguage"]';
        let genresID;

        const NewesMovieswrapper = document.querySelector('.Newest-Movies-Wrapper');
        const BestMoviesWrapper = document.querySelector('.best-moveis-wrapper');
        const BestShowsWrapper = document.querySelector('.best-shows-wrapper');
        const AdventureMoviesWrapper = document.querySelector('.Adventure-movies-wrapper');
        const actionMoviesWrapper = document.querySelector('.action-movies-wrapper');
        const herrorMoviesWrapper = document.querySelector('.herror-movies-wrapper');
        const rightSection = document.querySelector('.right-section');
        const leftSection = document.querySelector('.left-section');
        const singlePageHeader = document.querySelector('.singlePage-header');
        const downloadContainer = document.querySelector('.download-section');
        const relatedMoviesWrapper = document.querySelector('.related-movies-wrapper');
        const replysShow = document.querySelector('.reply-show')

        const genres = function (arr) {
            const { genres } = arr;
            const [fGenres] = genres;
            const genreNames = genres.map(g => g.name).join(', ');
            return genreNames;
        }
        const resGenresID = function (arr) {
            const { genres } = arr;
            const [fGenres] = genres;
            genresID = fGenres.id;
            return genresID;
        }


        const countrys = function (arr) {
            const { production_countries } = arr;
            const countrysName = production_countries.map(g => g.name).join(', ');
            return countrysName;
        }



        const renderSinglePagePoster = async function () {
            const res = await fetch(`https://api.themoviedb.org/3/${format}/${ID}?api_key=${apiKey}`);
            const data = await res.json();
            const poster = document.createElement('div');
            poster.classList.add('poster-container');
            console.log(data)
            poster.innerHTML = `
                          <img src="https://image.tmdb.org/t/p/w342${data.poster_path}" alt="" class="poster">
                             `;
            rightSection.appendChild(poster);

            const background = document.createElement('img');
            background.src = `https://image.tmdb.org/t/p/original${data.backdrop_path}`;
            background.classList.add('bg-img');
            console.log(data)
            singlePageHeader.appendChild(background);
        }
        renderSinglePagePoster();

        const renderSinglePageDetails = async function () {
            const res = await fetch(`https://api.themoviedb.org/3/${format}/${ID}?api_key=${apiKey}&language=${language}`);
            const data = await res.json();
            const Details = document.createElement('div');
            Details.classList.add('movieDetails');

            const genresName = genres(data);
            const countrysName = countrys(data);
            var rating = Number(data.vote_average).toFixed(1);
            const DetailsHTML = format === 'tv' ? `
                                       <ul>
                                   <li>
                                      <span>@Localizer["Name"]: ${data.name || data.title}</span>
                                   </li>
                                   <li>
                                       <span>@Localizer["Genre"]: ${genresName}</span>
                                   </li>
                                   <li>
                                       <span>@Localizer["Rating"]: ${rating} </span>
                                   </li>
                                   <li>
                                       <span>@Localizer["CountryOfOrigin"]: ${countrysName}</span>
                                   </li>

                                     <li><span>@Localizer["NumberOfSeasons"]: ${data.number_of_seasons}</span></li>
                                   <li>
                                       <span>@Localizer["NumberOfEpisodes"]: ${data.number_of_episodes}</span>
                                   </li>
                                   <li>
                                       <span>@Localizer["PlotSummary"]: ${data.overview || 'ندارد'}</span>
                                   </li>
                               </ul>
               ` : `
                                       <ul>
                                   <li>
                                       <span>@Localizer["Name"]: ${data.name || data.title}</span>
                                   </li>
                                   <li>
                                       <span>@Localizer["Genre"]: ${genresName}</span>
                                   </li>
                                   <li>
                                       <span>@Localizer["Rating"]: ${rating} </span>
                                   </li>
                                   <li>
                                       <span>@Localizer["CountryOfOrigin"]: ${countrysName}</span>
                                   <li>
                                       <span>@Localizer["PlotSummary"]: ${data.overview || '@Localizer["NoDescription"]'}</span>
                                   </li>
                               </ul>
               `;


            Details.innerHTML = DetailsHTML;

            leftSection.appendChild(Details);
        }

        renderSinglePageDetails()

        const renderSeasonsEpisodes = async function (tvID) {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/${format}/${tvID}?api_key=${apiKey}&language=${language}`);
                const data = await res.json();
                if (format === "tv") {
                    for (const season of data.seasons) {
                        if (season.season_number === 0) continue;


                        const seasonWrapper = document.createElement('div');
                        seasonWrapper.classList.add('season-wrapper');

                        seasonWrapper.innerHTML = `
                                                                                            <div class="season-header">@Localizer["Season"] ${season.season_number}</div>
                                                                                    <div class="season-body" style="display: none;"></div>
                                                                                  `;

                        downloadContainer.appendChild(seasonWrapper);

                        const seasonBody = seasonWrapper.querySelector('.season-body');


                        const header = seasonWrapper.querySelector('.season-header');
                        header.addEventListener('click', () => {
                            const visible = seasonBody.style.display === 'block';
                            seasonBody.style.display = visible ? 'none' : 'block';
                        });


                        const seasonRes = await fetch(`https://api.themoviedb.org/3/tv/${tvID}/season/${season.season_number}?api_key=${apiKey}&language=${language}`);
                        const seasonData = await seasonRes.json();

                        seasonData.episodes.forEach(episode => {
                            const episodeBox = document.createElement('div');
                            episodeBox.classList.add('episode-box');
                            episodeBox.innerHTML = `
                                              <h4 dir="@Localizer["dir"]">@Localizer["Episode"] ${episode.episode_number}:</h4>
                                              <div class="quality-buttons">
                                                <a href="@ViewBag.DownloadLink?format=@format&postName=${data.name || data.title}&season=${season.season_number}&episode=${episode.episode_number}&quality=480p" class="quality-btn">480p</a>
                                                <a href="@ViewBag.DownloadLink?format=@format&postName=${data.name || data.title}&season=${season.season_number}&episode=${episode.episode_number}&quality=720p" class="quality-btn">720p</a>
                                                <a href="@ViewBag.DownloadLink?format=@format&postName=${data.name || data.title}&season=${season.season_number}&episode=${episode.episode_number}&quality=1080p" class="quality-btn">1080p</a>
                                              </div>
                                              `;
                            seasonBody.appendChild(episodeBox);
                        });
                    }
                } else {
                    const elem = document.createElement('div');
                    elem.classList.add('movie-download');
                    elem.innerHTML = `
                                            <a href="@ViewBag.DownloadLink?format=@format&postName=${data.name || data.title}&quality=480p">@Localizer["DownloadQuality480"]</a>
                                            <a href="@ViewBag.DownloadLink?format=@format&postName=${data.name || data.title}&quality=480p">@Localizer["DownloadQuality720"]</a>
                                            <a href="@ViewBag.DownloadLink?format=@format&postName=${data.name || data.title}&quality=480p">@Localizer["DownloadQuality1080"]</a>
                                                                                `;
                    downloadContainer.appendChild(elem)

                }

            } catch (err) {
                console.error('@Localizer["FetchEpisodesError"]', err);
            }
        };

        renderSeasonsEpisodes(ID)

        let renderRelatedMovies = async function () {
            try {
                const res1 = await fetch(`https://api.themoviedb.org/3/${format}/${ID}?api_key=${apiKey}&language=${language}`);
                const data1 = await res1.json();
                const { genres } = data1;
                const genres1 = genres[0].id;

                const res = await fetch(`https://api.themoviedb.org/3/discover/${format}?api_key=${apiKey}&sort_by=vote_average.desc&with_genres=${genres1}&vote_count.gte=100`);
                const data = await res.json();
                data.results.forEach(movie => {
                    if (movie.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide', 'related-movies-slide');
                        slide.innerHTML = `
                                                                                    <a href="/@format?id=${movie.id}&format=@format"> <img src="https://image.tmdb.org/t/p/w342${movie.poster_path}" alt="${movie.name}"></a>
                                                                                  `;
                        relatedMoviesWrapper.appendChild(slide);

                    }
                });

                const relatedMoviesSwiper = new Swiper(".related-movies-swiper", {
                    slidesPerView: 5,
                    centeredslides: false,
                    spaceBetween: 50,
                    pagination: {
                        el: ".related-movies-swiper .swiper-pagination",
                        type: "fraction",
                    },
                    navigation: {
                        nextEl: ".related-movies-swiper .swiper-button-next",
                        prevEl: ".related-movies-swiper .swiper-button-prev",
                    },

                });
            } catch (err) {
                console.error('@Localizer["FetchDataError"]', err)
            }
        }

        renderRelatedMovies();



        document.querySelectorAll('.reply-show').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const comment = this.closest('.comment');

                const replys = comment.querySelector('.replys');

                if (replys.style.display === 'none' || !replys.style.display) {
                    replys.style.display = 'flex';
                    this.querySelector('svg').classList.add('rotate');
                } else {
                    replys.style.display = 'none';
                    this.querySelector('svg').classList.remove('rotate');
                }
            });
        });

        const roleCheckbox = document.querySelector('.roles-checkbox ');
        const registedbtn = document.querySelector('.registedbtn');

        if (!roleCheckbox.checked) {
            registedbtn.setAttribute('disabled', '');
        }

        roleCheckbox.addEventListener('change', function () {
            if (!roleCheckbox.checked) {
                registedbtn.setAttribute('disabled', '');
            } else {

                registedbtn.removeAttribute('disabled');
            }
        });

        tex
    </script>
    <script>
        $(function () {
            if ('@TempData["CommentError"]' !== '') {
                $("#comment-modal").modal("show");
            }
        });
        $(function () {
            if ('@TempData["ReplyError"]' !== '') {
                $("#reply-modal-@TempData["RepliedCommentId"]").modal("show");
            }
        });
    </script>
}
