@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Home"];
}
@section firstScript {

    <script src="./js/bootstrap.bundle.min.js"></script>
}
@section Language{
    <a class="language text-nowrap" href="/Home/SetLanguage?culture=@Localizer["Language"]&returnUrl=/">@Localizer["Language"]</a>

    <a href="/Home/SetLanguage?culture=@Localizer["Language"]&returnUrl=/" class="language-icon">
