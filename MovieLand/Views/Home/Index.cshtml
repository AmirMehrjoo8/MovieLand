<div class="swiper mySwiper">
    <div class="swiper-wrapper Newest-Movies-Wrapper">
    </div>
    <div class="swiper-pagination"></div>
</div>
<div class="shape-1"></div>
<div class="shape-4"></div>
<div class="best-movies-container">
    <h2>@Localizer["TheBestMovies"]:</h2>
    <div class="swiper manipulation-swiper">
        <div class="swiper-wrapper best-moveis-wrapper" style="transform: translate3d(0px, 0px, 0px);">
        </div>
        <div class="swiper-button-next"></div>

    </div>
</div>

<div class="random-backdrop-container" id="random-backdrop-container">
</div>
<div class="shape-2"></div>
<div class="shape-5"></div>
<div class="best-shows-container">
    <h2>@Localizer["TheBestSeries"]:</h2>

    <div class="swiper best-shows-swiper">
        <div class="swiper-wrapper best-shows-wrapper">
        </div>

        <!-- فقط فلش بعدی -->
        <div class="swiper-button-next best-shows-next"></div>
        <div class="swiper-button-prev best-shows-next"></div>
    </div>
</div>
<div id="random-show-backdrop-container">
</div>
<div class="shape-3"></div>
<div class="shape-6"></div>
<div class="Adventure-movies-container">
    <h2> @Localizer["AdventureMovies"]:</h2>

    <div class="swiper Adventure-movies-swiper">
        <div class="swiper-wrapper Adventure-movies-wrapper">
        </div>
        <div class="swiper-button-prev Adventure-movies-prev"></div>
        <div class="swiper-button-next Adventure-movies-next"></div>
    </div>
</div>
<div class="action-movies-container">
    <h2> @Localizer["ActionMovies"]:</h2>

    <div class="swiper action-movies-swiper">
        <div class="swiper-wrapper action-movies-wrapper">
        </div>

        <!-- فلش‌های ناوبری -->
        <div class="swiper-button-prev action-movies-prev"></div>
        <div class="swiper-button-next action-movies-next"></div>
    </div>
</div>
<div class="herror-movies-container">
    <h2> @Localizer["HorrorMovies"]:</h2>

    <div class="swiper herror-movies-swiper">
        <div class="swiper-wrapper herror-movies-wrapper">
        </div>

        <div class="swiper-button-prev herror-movies-prev"></div>
        <div class="swiper-button-next herror-movies-next"></div>
    </div>
</div>

@section Scripts {

    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/main.js"></script>
    <script>
        "use strict";

        const renderNewesMovies = async function () {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/tv/popular?api_key=${apiKey}&page=1`);
                const data = await res.json();

                const filteredMovies = data.results.filter(movie => movie.backdrop_path);
                const thelast7 = filteredMovies.slice(0, 7);
                thelast7.forEach(movie => {
                    if (movie.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide');
                        slide.innerHTML = `
                              <a href="tv?id=${movie.id}&format=tv"><img src="https://image.tmdb.org/t/p/original${movie.backdrop_path}" alt="${movie.title}"></a>
                             `;
                        NewesMovieswrapper.appendChild(slide);
                    }
                });

                var swiper = new Swiper(".mySwiper", {
                    spaceBetween: 30,
                    centeredSlides: true,
                    autoplay: {
                        delay: 5000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: ".swiper-pagination",
                        clickable: true,
                    },
                });
            } catch (err) {
                console.error('@Localizer["ErrorFetchingData"]', err)
            }
        }
        renderNewesMovies()




        let renderBestMovies = async function () {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/movie/top_rated?api_key=${apiKey}&page=1`);
                const data = await res.json();
                data.results.forEach(movie => {
                    if (movie.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide', 'best-movie-slide');
                        slide.innerHTML = `
                                     <a href="movie?id=${movie.id}&format=movie"><img src="https://image.tmdb.org/t/p/w342${movie.poster_path}" alt="${movie.title}"></a>
                              `;
                        BestMoviesWrapper.appendChild(slide);

                    }
                });

                const manipulationSwiper = new Swiper(".manipulation-swiper", {
                    slidesPerView: 5,
                    centeredSlides: false,
                    spaceBetween: 50,
                    pagination: {
                        el: ".manipulation-swiper .swiper-pagination",
                        type: "fraction",
                    },
                    navigation: {
                        nextEl: ".manipulation-swiper .swiper-button-next",
                        prevEl: ".manipulation-swiper .swiper-button-prev",
                    },
                });
            } catch (err) {
                console.error('@Localizer["ErrorFetchingData"]', err)
            }
        }

        renderBestMovies();

        let appendNumber = 4;
        let prependNumber = 1;

        const getRandomBackdrop = async () => {
            try {
                const response = await fetch(
                    `https://api.themoviedb.org/3/movie/top_rated?api_key=${apiKey}&language=en-US&page=1`
                );
                const data = await response.json();

                const movies = data.results;

                if (!movies || movies.length === 0) return;

                const randomMovie = movies[Math.floor(Math.random() * movies.length)];

                if (randomMovie.backdrop_path) {
                    const imageUrl = `https://image.tmdb.org/t/p/w780${randomMovie.backdrop_path}`;
                    const container = document.getElementById("random-backdrop-container");
                    container.innerHTML = `
                            <a href="movie?id=${randomMovie.id}&format=movie"> <img src="${imageUrl}" alt="${randomMovie.title}"> </a>
                                  `;
                } else {
                    document.getElementById("random-backdrop-container").innerHTML =
                        "@Localizer["NoBackdropFound"]";
                }
            } catch (err) {
                document.getElementById("random-backdrop-container").innerHTML =
                    "@Localizer["ErrorFetchingData"]";
                console.error(err);
            }
        };

        getRandomBackdrop();



        let renderBestshows = async function () {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/tv/top_rated?api_key=${apiKey}&page=1`);
                const data = await res.json();
                data.results.forEach(show => {
                    if (show.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide', 'best-shows-slide');
                        slide.innerHTML = `
                                  <a href="tv?id=${show.id}&format=tv"> <img src="https://image.tmdb.org/t/p/w342${show.poster_path}" alt="${show.name}"></a>
                              `;
                        BestShowsWrapper.appendChild(slide);

                    }
                });

                const bestShowsSwiper = new Swiper(".best-shows-swiper", {
                    slidesPerView: 5,
                    centeredSlides: false,
                    spaceBetween: 50,
                    pagination: {
                        el: "best-shows-swiper .swiper-pagination",
                        type: "fraction",
                    },
                    navigation: {
                        nextEl: ".best-shows-swiper .swiper-button-next",
                        prevEl: ".best-shows-swiper .swiper-button-prev",
                    },
                });
            } catch (err) {
                console.error('@Localizer["ErrorFetchingData"]', err)
            }
        }

        renderBestshows();

        const getRandomTVBackdrop = async () => {
            try {
                const response = await fetch(
                    `https://api.themoviedb.org/3/tv/top_rated?api_key=${apiKey}&page=1`
                );
                const data = await response.json();

                const shows = data.results;
                if (!shows || shows.length === 0) return;

                // انتخاب رندوم
                const randomShow = shows[Math.floor(Math.random() * shows.length)];

                if (randomShow.backdrop_path) {
                    const imageUrl = `https://image.tmdb.org/t/p/w780${randomShow.backdrop_path}`;
                    const container = document.getElementById(
                        "random-show-backdrop-container"
                    );
                    container.innerHTML = `
                         <a href="tv?id=${randomShow.id}&format=tv"> <img src="${imageUrl}" alt="${randomShow.name}"> </a>
                                  `;
                }
            } catch (err) {
                document.getElementById("random-show-backdrop-container").innerHTML =
                    "@Localizer["ErrorFetchingData"]";
                console.error(err);
            }
        };

        getRandomTVBackdrop();



        let renderAdventureMovies = async function () {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/discover/movie?api_key=${apiKey}&sort_by=vote_average.desc&with_genres=12&vote_count.gte=100
                        `);
                const data = await res.json();
                data.results.forEach(movie => {
                    if (movie.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide', 'Adventure-movies-slide');
                        slide.innerHTML = `
                             <a href="movie?id=${movie.id}&format=movie"> <img src="https://image.tmdb.org/t/p/w342${movie.poster_path}" alt="${movie.name}"></a>
                              `;
                        AdventureMoviesWrapper.appendChild(slide);

                    }
                });

                const AdventureMoviesSwiper = new Swiper(".Adventure-movies-swiper", {
                    slidesPerView: 5,
                    centeredSlides: false,
                    spaceBetween: 50,
                    pagination: {
                        el: ".Adventure-movies-swiper .swiper-pagination",
                        type: "fraction",
                    },
                    navigation: {
                        nextEl: ".Adventure-movies-swiper .swiper-button-next",
                        prevEl: ".Adventure-movies-swiper .swiper-button-prev",
                    },
                });
            } catch (err) {
                console.error('@Localizer["ErrorFetchingData"]', err)
            }
        }

        renderAdventureMovies();



        let renderActionMovies = async function () {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/discover/movie?api_key=${apiKey}&sort_by=vote_average.desc&with_genres=28&vote_count.gte=100
                        `);
                const data = await res.json();
                data.results.forEach(movie => {
                    if (movie.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide', 'action-movies-slide');
                        slide.innerHTML = `
                                  <a href="movie?id=${movie.id}&format=movie"> <img src="https://image.tmdb.org/t/p/w342${movie.poster_path}" alt="${movie.name}"></a>
                              `;
                        actionMoviesWrapper.appendChild(slide);

                    }
                });

                const actionMoviesSwiper = new Swiper(".action-movies-swiper", {
                    slidesPerView: 5,
                    centeredSlides: false,
                    spaceBetween: 50,
                    pagination: {
                        el: ".action-movies-swiper .swiper-pagination",
                        type: "fraction",
                    },
                    navigation: {
                        nextEl: ".action-movies-swiper .swiper-button-next",
                        prevEl: ".action-movies-swiper .swiper-button-prev",
                    },
                });
            } catch (err) {
                console.error('@Localizer["ErrorFetchingData"]', err)
            }
        }

        renderActionMovies();



        let renderHerrorMovies = async function () {
            try {
                const res = await fetch(`https://api.themoviedb.org/3/discover/movie?api_key=${apiKey}&sort_by=vote_average.desc&with_genres=27&vote_count.gte=100
                        `);
                const data = await res.json();
                data.results.forEach(movie => {
                    if (movie.backdrop_path) {
                        const slide = document.createElement('div');
                        slide.classList.add('swiper-slide', 'herror-movies-slide');
                        slide.innerHTML = `
                                   <a href="movie?id=${movie.id}&format=movie"> <img src="https://image.tmdb.org/t/p/w342${movie.poster_path}" alt="${movie.name}"></a>
                              `;
                        herrorMoviesWrapper.appendChild(slide);

                    }
                });

                const herrorMoviesSwiper = new Swiper(".herror-movies-swiper", {
                    slidesPerView: 5,
                    centeredSlides: false,
                    spaceBetween: 50,
                    pagination: {
                        el: ".herror-movies-swiper .swiper-pagination",
                        type: "fraction",
                    },
                    navigation: {
                        nextEl: ".herror-movies-swiper .swiper-button-next",
                        prevEl: ".herror-movies-swiper .swiper-button-prev",
                    },
                });
            } catch (err) {
                console.error('@Localizer["ErrorFetchingData"]', err)
            }
        }

        renderHerrorMovies();
        // const showRegisterLink = document.getElementById('showRegister');
        // const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
        // const registerModal = new bootstrap.Modal(document.getElementById('registerModal'));

        // showRegisterLink.addEventListener('click', function (e) {
        //     e.preventDefault();
        //     loginModal.hide();
        //     registerModal.show();
        // }); I MOVED THIS CODE TO THE LAYOUT

        const categoryIcon = document.querySelector('.category-icon');

        categoryIcon.addEventListener('click', function (e) {
            e.preventDefault;
        });


    </script>
    <script>
        $(function () {
            if ('@TempData["LoginError"]' !== '') {
                $("#loginModal").modal("show");
            }
        });
        $(function () {
            if ('@TempData["RegisterError"]' !== '') {
                $("#registerModal").modal("show");
            }
        });
    </script>
}