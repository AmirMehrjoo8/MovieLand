@model MovieLand.Models.User
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@using MovieLand.Classes;
@{
    ViewData["Title"] = Localizer["Profile"].Value + " - " + User.Identity.Name;
}

@section Language {
    <a class="language text-nowrap" href="/Home/SetLanguage?culture=@Localizer["Language"]&returnUrl=/Account/Profile">@Localizer["Language"]</a>

    <a href="/Home/SetLanguage?culture=@Localizer["Language"]&returnUrl=/Account/Profile" class="language-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-globe" viewBox="0 0 16 16">
            <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855A8 8 0 0 0 5.145 4H7.5zM4.09 4a9.3 9.3 0 0 1 .64-1.539 7 7 0 0 1 .597-.933A7.03 7.03 0 0 0 2.255 4zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a7 7 0 0 0-.656 2.5zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5zM8.5 5v2.5h2.99a12.5 12.5 0 0 0-.337-2.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5zM5.145 12q.208.58.468 1.068c.552 1.035 1.218 1.65 1.887 1.855V12zm.182 2.472a7 7 0 0 1-.597-.933A9.3 9.3 0 0 1 4.09 12H2.255a7 7 0 0 0 3.072 2.472M3.82 11a13.7 13.7 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5zm6.853 3.472A7 7 0 0 0 13.745 12H11.91a9.3 9.3 0 0 1-.64 1.539 7 7 0 0 1-.597.933M8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855q.26-.487.468-1.068zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.7 13.7 0 0 1-.312 2.5m2.802-3.5a7 7 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7 7 0 0 0-3.072-2.472c.218.284.418.598.597.933M10.855 4a8 8 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4z" />
        </svg>
    </a>
}
@if (Localizer["Language"].Value == "fa-IR")
{
    <style>
        .top-side {
            flex-direction: row-reverse;
        }
    </style>
}
<div class="accountDetails-container">
    <div class="top-side">
        <div class="right">
            <div class="img-container">
                <img src="@UserProfile.ProfilePictureLocation(Model.UserId.ToString())"
                     alt="" />
            </div>
            <div class="name-container"><span>@Model.Name</span></div>
        </div>
        <div class="left">
            <ul>
                <li><span>@Localizer["Username"] :</span> <span>@Model.Username</span></li>
                <li><span>@Localizer["Phone"] :</span> <span>@Model.Phone</span></li>
                <li><span>@Localizer["AccountType"] :</span> <span>@UserProfile.GetUserType(Model.Type, Model.SubCardId)</span></li>
                <li>
                    @if (User.Identity.IsAuthenticated && Context.User.FindFirst("Type").Value == "1")
                    {
                        <a href="/Admin/Dashbord" class="text text-nowrap btn btn-outline-warning" style="margin-bottom:10px;">@Localizer["AdminPanel"]</a>
                    }
                </li>
            </ul>
            <div class="button-container">
                <button class="btn profileEdit "
                        data-bs-toggle="modal"
                        data-bs-target="#ProfileEditModal">
                    @Localizer["EditProfile"]
                </button>
            </div>
            @await Component.InvokeAsync(name: "EditProfile", Model.UserId)
        </div>
    </div>
    <div class="bottom-side">
        <h2>@Localizer["SubInfo"] :</h2>
        @{
            var subId = Model.SubCardId;

            var cards = new List<dynamic>
        {
        new { Id = 2, Title = "BronzeSubscription", Duration = $"{ViewBag.SubCard2Credit}Months", Ads = "RemoveAds", Download = "LimitedDownloads", Support = "NoSupport", Css = "bronze" },
        new { Id = 3, Title = "SilverSubscription", Duration = $"{ViewBag.SubCard3Credit}Months", Ads = "RemoveAds", Download = "UnlimitedDownloads", Support = "StandardSupport", Css = "silver" },
        new { Id = 4, Title = "GoldSubscription",   Duration = $"{ViewBag.SubCard4Credit}Months",    Ads = "RemoveAds", Download = "UnlimitedDownloads", Support = "PrioritySupport", Css = "gold" },
        };

            var active = cards.FirstOrDefault(c => c.Id == subId);
            var others = cards.Where(c => c.Id != subId).ToList();
        }

        <div class="subCard-container">
            @if (others.Count == 2)
            {
                <!-- کارت اول غیرفعال -->
                <div class="subCard @others[1].Css">
                    <div class="top">
                        <h4 class="sub-title">@Localizer[others[1].Title]</h4>
                        <ul>
                            <li>@Localizer[others[1].Ads]</li>
                            <li>@Localizer[others[1].Download]</li>
                            <li>@Localizer[others[1].Support]</li>
                        </ul>
                    </div>
                    <div class="bottom">
                        <span class="sub-credit">@Localizer[others[1].Duration]</span>
                        <div class="sub-expiration">
                            <span>@Localizer["TimeRemaining"] :</span>
                        </div>
                    </div>
                </div>

                <!-- کارت فعال -->
                <div class="subCard @active.Css active">
                    <div class="top">
                        <h4 class="sub-title">@Localizer[active.Title]</h4>
                        <ul>
                            <li>@Localizer[active.Ads]</li>
                            <li>@Localizer[active.Download]</li>
                            <li>@Localizer[active.Support]</li>
                        </ul>
                    </div>
                    <div class="bottom">
                        <span class="sub-credit">@Localizer[active.Duration]</span>
                        <div class="sub-expiration">
                            <span>@Localizer["TimeRemaining"] :</span>
                            <span>@Model.SubExpireDate.SubTimeRemaining()</span>
                        </div>
                    </div>
                </div>

                <!-- کارت دوم غیرفعال -->
                <div class="subCard @others[0].Css">
                    <div class="top">
                        <h4 class="sub-title">@Localizer[others[0].Title]</h4>
                        <ul>
                            <li>@Localizer[others[0].Ads]</li>
                            <li>@Localizer[others[0].Download]</li>
                            <li>@Localizer[others[0].Support]</li>
                        </ul>
                    </div>
                    <div class="bottom">
                        <span class="sub-credit">@Localizer[others[0].Duration]</span>
                        <div class="sub-expiration">
                            <span>@Localizer["TimeRemaining"] :</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="card shadow-lg p-4 border-warning border-3 rounded-4" style="max-width: 800px; width: 100%; background: linear-gradient(135deg, #fffbe6, #fff);">
                        <div class="card-body text-center">
                            <h2 class="card-title mb-3 text-danger fw-bold">@Localizer["NoSubTitle"]</h2>
                            <p class="card-text fs-5 text-secondary">
                                @Localizer["NoSubErrMsg"]
                            </p>
                            <a href="/Subscription/BuySub" class="btn btn-warning btn-lg px-4 fw-bold">
                                @Localizer["BuySub"]
                                <svg xmlns="http://www.w3.org/2000/svg" style="transform: rotate(270deg);" width="20" height="20" fill="currentColor" class="bi bi-arrow-down" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 13.293V1.5A.5.5 0 0 1 8 1"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


<div class="modal fade"
     id="ProfileAlert"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <p class="text-success p-3 text-center">
                @TempData["ProfileAlert"]
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const input = document.getElementById('profilePicInput');
        const preview = document.getElementById('profilePicPreview');

        input.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.setAttribute('src', e.target.result);
                };

                reader.readAsDataURL(file);
            }
        });


    </script>

    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
        $(function () {
            if ('@TempData["EditProfileError"]' !== '') {
                $("#ProfileEditModal").modal("show");
            }
        });
        $(function () {
            if ('@TempData["ProfileAlert"]' !== '') {
                $("#ProfileAlert").modal("show");
            }
        });
    </script>
}