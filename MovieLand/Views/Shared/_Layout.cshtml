    @await RenderSectionAsync("Scripts", required: false)
    <script>

        const searchInput = document.querySelector('.nav-search');
        const searchResults = document.querySelector('.search-results');
        let debounceTimer = null;

        async function liveSearch(query) {
            if (!query) {
                searchResults.innerHTML = '';
                searchResults.style.display = 'none';
                return;
            }

            try {
                const [movieRes, tvRes] = await Promise.all([
                    fetch(`https://api.themoviedb.org/3/search/movie?api_key=${apiKey}&query=${encodeURIComponent(query)}`),
                    fetch(`https://api.themoviedb.org/3/search/tv?api_key=${apiKey}&query=${encodeURIComponent(query)}`)
                ]);

                const [movieData, tvData] = await Promise.all([movieRes.json(), tvRes.json()]);
                const results = [...movieData.results, ...tvData.results];

                searchResults.innerHTML = '';

                if (results.length === 0) {
                    searchResults.innerHTML = '<p style="color:#fff;">@Localizer["NoResultsFound"]</p>';
                    searchResults.style.display = 'flex';
                    return;
                }

                results.slice(0, 10).forEach(item => {
                    if (!item.poster_path) return;

                    const box = document.createElement('div');
                    box.className = 'search-box';
                    box.innerHTML = `
                        <a href="/${item.title ? 'movie' : 'tv'}?id=${item.id}&format=${item.title ? 'movie' : 'tv'}">
                          <img src="https://image.tmdb.org/t/p/w342${item.poster_path}" alt="${item.title || item.name}">
                          <span>${item.title || item.name}</span>
                        </a>
                      `;
                    searchResults.appendChild(box);
                });

                searchResults.style.display = 'flex';
            } catch (err) {
                console.error('@Localizer["SearchError"]', err);
                searchResults.innerHTML = '<p style="color:red;">@Localizer["UnexpectedError"]</p>';
                searchResults.style.display = 'flex';
            }
        }

        // کنترل جستجوی زنده با debounce (جلوگیری از فراخوانی زیاد API)
        searchInput.addEventListener('input', () => {
            const query = searchInput.value.trim();

            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                liveSearch(query);
            }, 400); // صبر کن ۴۰۰ میلی‌ثانیه بعد از آخرین تایپ
        });


    </script>
    <script>
        const showRegisterLink = document.getElementById('showRegister');
        const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
        const registerModal = new bootstrap.Modal(document.getElementById('registerModal'));

        showRegisterLink.addEventListener('click', function (e) {
            e.preventDefault();
            loginModal.hide();
            registerModal.show();
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>

</html>