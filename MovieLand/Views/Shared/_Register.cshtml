@model MovieLand.Models.ViewModels.RegisterVM
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
<div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["CreateAccount"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (TempData["RegisterError"] != null)
                {
                    <div class="text-danger text-center">
                        @TempData["RegisterError"]
                    </div>
                }
                <form asp-action="Register" asp-controller="Account" id="RegisterForm">
                    <input type="hidden" value="@Localizer["Language"]" name="lan"/>
                    <div class="mb-2">
                        <label class="form-label">@Localizer["Name"]</label><span asp-validation-for="Name" class="text-danger"></span>
                            <input asp-for="Name" class="form-control" value="@TempData["Name"]">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Localizer["Username"]</label><span asp-validation-for="Username" class="text-danger"></span>
                            <input asp-for="Username" class="form-control" value="@TempData["Username"]">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Localizer["Password"]</label><span asp-validation-for="Password" class="text-danger"></span>
                            <input asp-for="Password" class="form-control">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Localizer["RepeatPassword"]</label><span asp-validation-for="RePassword" class="text-danger"></span>
                        <input asp-for="RePassword" class="form-control">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Localizer["Email"]</label><span asp-validation-for="Email" class="text-danger"></span>
                        <input asp-for="Email" class="form-control" value="@TempData["Email"]">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Phone"]</label><span asp-validation-for="Phone" class="text-danger"></span>
                        <input asp-for="Phone" class="form-control" value="@TempData["Phone"]">
                    </div>
                    <div class="roles">
                        <input asp-for="Rules" class="roles-checkbox"><span>
                            @Localizer["ReadRules1"]
                            <a href="/Rules"> @Localizer["Rules"] </a>
                            @Localizer["ReadRules2"]
                        </span>
                    </div>
                    <button type="submit" class="btn btn-success w-100 registedbtn">@Localizer["Create"]</button>
                </form>
            </div>
        </div>
    </div>
</div>