@using System.Security.Claims
@model IEnumerable<MovieLand.Models.SubCard>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject MovieLand.Data.Repository.IUserRepository _userRepository;

@{
    ViewData["Title"] = Localizer["SubscriptionTitle"].Value;
}
@section Language {
    <a class="language text-nowrap" href="/Home/SetLanguage?culture=@Localizer["Language"]&returnUrl=/Subscription/BuySub">@Localizer["Language"]</a>

    <a href="/Home/SetLanguage?culture=@Localizer["Language"]&returnUrl=/" class="language-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-globe" viewBox="0 0 16 16">
            <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855A8 8 0 0 0 5.145 4H7.5zM4.09 4a9.3 9.3 0 0 1 .64-1.539 7 7 0 0 1 .597-.933A7.03 7.03 0 0 0 2.255 4zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a7 7 0 0 0-.656 2.5zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5zM8.5 5v2.5h2.99a12.5 12.5 0 0 0-.337-2.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5zM5.145 12q.208.58.468 1.068c.552 1.035 1.218 1.65 1.887 1.855V12zm.182 2.472a7 7 0 0 1-.597-.933A9.3 9.3 0 0 1 4.09 12H2.255a7 7 0 0 0 3.072 2.472M3.82 11a13.7 13.7 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5zm6.853 3.472A7 7 0 0 0 13.745 12H11.91a9.3 9.3 0 0 1-.64 1.539 7 7 0 0 1-.597.933M8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855q.26-.487.468-1.068zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.7 13.7 0 0 1-.312 2.5m2.802-3.5a7 7 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7 7 0 0 0-3.072-2.472c.218.284.418.598.597.933M10.855 4a8 8 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4z" />
        </svg>
    </a>
}
<div class="discription">
    <p>
        @Localizer["Description"]
    </p>
</div>
@if (User.Identity.IsAuthenticated)
{
    if (_userRepository.GetById(int.Parse(User.FindFirst(ClaimTypes.NameIdentifier).Value)).SubCardId > 1)
    {
        <div class="border p-2 discription text-danger text-center border-danger">
            <p>
                @Localizer["Warning"]
            </p>
        </div>
    }
}

<div class="subCard-container">
    <a href="" data-bs-toggle="modal" data-bs-target="#buy-subscription-4">
        <div class="subCard gold">
            <div class="top">
                <h4 class="sub-title">@Localizer["GoldPlanTitle"]</h4>
                <ul>
                    @foreach (var item in Localizer["GoldPlanFeatures"].Value.Split(','))
                    {
                        <li>@item.Trim()</li>
                    }
                </ul>
            </div>
            <div class="bottom">
                <span class="sub-credit">@Model.Single(s => s.SubCardId == 4).Credit @Localizer["Duration"]</span>
                <span class="sub-price">@Model.Single(s => s.SubCardId == 4).Price.ToString("#,0") @Localizer["Price"]</span>
            </div>
        </div>
    </a>
    <a href="" data-bs-toggle="modal" data-bs-target="#buy-subscription-3">
        <div class="subCard silver">
            <div class="top">
                <h4 class="sub-title">@Localizer["SilverPlanTitle"]</h4>
                <ul>
                    @foreach (var item in Localizer["SilverPlanFeatures"].Value.Split(','))
                    {
                        <li>@item.Trim()</li>
                    }
                </ul>
            </div>
            <div class="bottom">
                <span class="sub-credit">@Model.Single(s => s.SubCardId == 3).Credit @Localizer["Duration"]</span>
                <span class="sub-price">@Model.Single(s => s.SubCardId == 3).Price.ToString("#,0") @Localizer["Price"]</span>
            </div>
        </div>
    </a>
    <a href="" data-bs-toggle="modal" data-bs-target="#buy-subscription-2">
        <div class="subCard bronze">
            <div class="top">
                <h4 class="sub-title">@Localizer["BronzePlanTitle"]</h4>
                <ul>
                    @foreach (var item in Localizer["BronzePlanFeatures"].Value.Split(','))
                    {
                        <li>@item.Trim()</li>
                    }
                </ul>
            </div>
            <div class="bottom">
                <span class="sub-credit">@Model.Single(s => s.SubCardId == 2).Credit @Localizer["Duration"]</span>
                <span class="sub-price">@Model.Single(s => s.SubCardId == 2).Price.ToString("#,0") @Localizer["Price"]</span>
            </div>
        </div>
    </a>
    @for (int i = 2; i <= 4; i++)
    {
        <div class="modal fade" id="buy-subscription-@i" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="Payment" asp-controller="Subscription">
                            <div class="mb-3">
                                <input type="hidden" name="cardId" value="@i" />
                                <label class="form-label">@Localizer["DiscountCode"]</label>
                                <input type="text" name="discountCode" class="form-control" placeholder="@Localizer["DiscountCodePlaceholder"]">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">@Localizer["Buy"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade"
     id="DownloadErr"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <p class="text-danger p-3 text-center">
                @TempData["DownloadErr"]
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
        $(function () {
            if ('@TempData["DownloadErr"]' !== '') {
                $("#DownloadErr").modal("show");
            }
        });
    </script>
}